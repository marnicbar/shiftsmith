# Copy to `.env` next to the compose file and edit. Compose picks it up
# automatically; `docker compose config` shows what it resolves to.

# --- Release ----------------------------------------------------------------
# `latest` also exists, but then a restart can be an upgrade. A digest
# (ghcr.io/marnicbar/shiftsmith@sha256:...) is the strictest pin.
SHIFTSMITH_VERSION=0.1.0

# --- Database ---------------------------------------------------------------
POSTGRES_USER=shiftsmith
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiftsmith
# Where the bundled PostgreSQL keeps its files (docker-compose.yml only).
POSTGRES_DATA_DIR=./data/postgres
# For docker-compose.external-db.yml — your own PostgreSQL 14+.
#POSTGRES_JDBC_URL=jdbc:postgresql://db.internal:5432/shiftsmith?sslmode=require

# --- First admin account ----------------------------------------------------
# Applied on the first boot only. Rotate later under Account → Sign-in.
SHIFTSMITH_ADMIN_USERNAME=admin
SHIFTSMITH_ADMIN_PASSWORD=change-me-too

# --- App --------------------------------------------------------------------
# Your business timezone — decides when "today" and the solve horizon roll over.
TZ=Europe/Berlin
# Keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 exposes plain HTTP.
SHIFTSMITH_BIND=127.0.0.1
SHIFTSMITH_PORT=8080
SHIFTSMITH_MEM_LIMIT=1g
SHIFTSMITH_CPUS=2.0
