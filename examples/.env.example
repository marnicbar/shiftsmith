# Copy to `.env` next to the compose file and edit. Docker Compose reads it
# automatically; `docker compose config` prints the result if you want to check
# what the file resolves to before starting anything.

# --- Release ----------------------------------------------------------------
# Pin the version you deploy. `latest` also exists but makes a restart a
# potential upgrade; see README.md → Upgrading. A digest
# (ghcr.io/marnicbar/shiftsmith@sha256:...) is the strictest pin of all.
SHIFTSMITH_VERSION=0.1.0

# --- Database ---------------------------------------------------------------
POSTGRES_USER=shiftsmith
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shiftsmith
# Where the bundled PostgreSQL keeps its files on the host (docker-compose.yml only).
POSTGRES_DATA_DIR=./data/postgres
# Only for docker-compose.external-db.yml — your own PostgreSQL 14+.
#POSTGRES_JDBC_URL=jdbc:postgresql://db.internal:5432/shiftsmith?sslmode=require

# --- First admin account ----------------------------------------------------
# Applied when the database is empty, i.e. on the very first boot. Rotate later
# in the app under Account → Sign-in.
SHIFTSMITH_ADMIN_USERNAME=admin
SHIFTSMITH_ADMIN_PASSWORD=change-me-too

# --- App --------------------------------------------------------------------
# Your business timezone: the schedule model is zone-less, so this decides when
# "today" and the solve horizon roll over.
TZ=Europe/Berlin
# Host interface and port the UI/API is published on. Keep 127.0.0.1 behind a
# reverse proxy; 0.0.0.0 exposes it on the network as plain HTTP.
SHIFTSMITH_BIND=127.0.0.1
SHIFTSMITH_PORT=8080
# Resource ceiling for the solver container.
SHIFTSMITH_MEM_LIMIT=1g
SHIFTSMITH_CPUS=2.0
